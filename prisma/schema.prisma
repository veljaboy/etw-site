generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Tabela za autentifikaciju šefa (/chef)
model ChefConfig {
  id          String   @id @default("main")
  lozinkaHash String
  updatedAt   DateTime @updatedAt
}

// Tabela za Radnike (/radnik)
model Radnik {
  id          String    @id @default(cuid())
  ime         String
  boja        String    // Npr. '#3b82f6' za plavu
  lozinkaHash String    @default("") // Kriptovana (SHA-256) šifra radnika
  zadaci      Anfrage[] // Veza: Jedan radnik može imati više poslova
}

// Tabela za Poslove u kalendaru (koje šef sam unosi i raspoređuje)
model Anfrage {
  id                 String   @id @default(cuid())
  vorname            String
  nachname           String   @default("")
  telefon            String   @default("")
  email              String   @default("")
  adresse            String
  wunschtermin       String?  // Datum posla, npr. "2026-11-13"
  vremeOd            String?  // Početak u satima, npr. "08:00"
  vremeDo            String?  // Kraj u satima, npr. "11:00"
  beschreibung       String
  status             String   @default("NEU")
  slikaPre           String?  // Base64 / Data URL fotografije PRE radova (Vorher)
  slikaPosle         String?  // Base64 / Data URL fotografije POSLE radova (Nachher)
  izvestajRadnika    String?  // Opis izvršenih radova sa terena (Durchgeführte Arbeiten)
  auftragsscheinData String?  // JSON sa svim poljima popunjenog Auftragsschein formulara
  createdAt          DateTime @default(now())

  // Veza sa radnikom
  radnikId           String?
  radnik             Radnik?  @relation(fields: [radnikId], references: [id])
}
